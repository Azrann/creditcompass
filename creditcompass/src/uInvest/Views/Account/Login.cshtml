@using System.Collections.Specialized
@model uInvest.Models.LoginModel

@{
    Layout = "~/Views/Shared/Login_Layout.cshtml";
    ViewBag.Title = "";
}


    <div class="col-xs-12 col-sm-12 col-md-5 col-lg-4">
        <div class="well no-padding">
@using (Html.BeginForm("Login","Account", new { ReturnUrl = ViewBag.ReturnUrl},FormMethod.Post, new { @id="login-form",@class = "smart-form client-form"}))
{
    @Html.AntiForgeryToken()

                <header>
                    Sign In
                </header>
                <fieldset>
                    <section>
                        <label class="label">Username</label>
                        <label class="input"> <i class="icon-append fa fa-user"></i>
                            <input id="UserName" type="" name="UserName">
                            <b class="tooltip tooltip-top-right"><i class="fa fa-user txt-color-teal"></i> Please enter email address/username</b></label>
                    </section>

                    <section>
                        <label class="label">Password</label>
                        <label class="input"> <i class="icon-append fa fa-lock"></i>
                            <input id="Password" type="password" name="Password">
                            <b class="tooltip tooltip-top-right"><i class="fa fa-lock txt-color-teal"></i> Enter your password</b> </label>
                        <div class="note">
                            <a href="forgotpassword.html">Forgot password?</a>
                        </div>
                    </section>

                    <section>
                        <label class="checkbox">
                            <input type="checkbox" name="remember" checked="">
                            <i></i>Stay signed in</label>
                    </section>
                    <section>
                            @Html.ValidationSummary(true)
                    </section>
                </fieldset>
                <footer>
                    <button type="submit"  value="Iniciar sesión" class="btn btn-primary">
                        Sign in
                    </button>
                </footer>
}

        </div>
						
        <h5 class="text-center"> - Or sign in using -</h5>
															
        <ul class="list-inline text-center">
            <li>
                <a href="javascript:void(0);" class="btn btn-primary btn-circle"><i class="fa fa-facebook"></i></a>
            </li>
            <li>
                <a href="javascript:void(0);" class="btn btn-info btn-circle"><i class="fa fa-twitter"></i></a>
            </li>
            <li>
                <a href="javascript:void(0);" class="btn btn-warning btn-circle"><i class="fa fa-linkedin"></i></a>
            </li>
        </ul>
						
    </div>

@section Header {
    <span id="login-header-space"> <span class="hidden-mobile">Need an account?</span> @Html.ActionLink("Create account","Register","Account",new {@class = "btn btn-danger"}) </span>
}
